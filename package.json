{
  "name": "tiny-map",
  "version": "0.0.1",
  "description": "Vẽ một khu trên bản đồ, dựng thành mô hình thành phố 3D low-poly từ dữ liệu OpenStreetMap.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node bench/run.cjs",
    "heights": "node tools/gob-heights.mjs",
    "heights:tiles": "node tools/height-tiles.mjs",
    "wards": "node tools/wards.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "maplibre-gl": "^6.16.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.6",
    "geotiff": "^3.0.5",
    "polygon-clipping": "^0.15.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
